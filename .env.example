# Copy to .env and replace placeholders; no source-project credentials are reused.
SHIRIN_ENVIRONMENT=production
SHIRIN_DATABASE_URL=postgresql+asyncpg://shirin:CHANGE_ME@postgres:5432/shirin
SHIRIN_POSTGRES_PASSWORD=CHANGE_ME
# PostgreSQL pool per Python process; connections are opened on demand.
SHIRIN_DATABASE_POOL_SIZE=2
SHIRIN_DATABASE_MAX_OVERFLOW=1
SHIRIN_DATABASE_POOL_TIMEOUT=30
# Optional: run all three bots and notifications in one Python process.
SHIRIN_COMPACT_WORKERS=false
# Shared compact pool also covers nested webhook handler sessions.
SHIRIN_COMPACT_DATABASE_POOL_SIZE=4
SHIRIN_COMPACT_DATABASE_MAX_OVERFLOW=2
SHIRIN_AUTH_ACCESS_SECRET=REPLACE_WITH_UNIQUE_RANDOM_SECRET_AT_LEAST_32_CHARACTERS
SHIRIN_AUTH_COOKIE_SECURE=true
SHIRIN_AUTH_COOKIE_DOMAIN=
SHIRIN_USER_BOT_TOKEN=
SHIRIN_ADMIN_BOT_TOKEN=
SHIRIN_SUPERADMIN_BOT_TOKEN=
SHIRIN_SUPERADMIN_ALLOWED_IDS=
SHIRIN_WEBHOOK_SECRET=
SHIRIN_BOT_MODE=polling
SHIRIN_USER_BOT_USERNAME=
SHIRIN_ADMIN_BOT_USERNAME=
SHIRIN_SUPERADMIN_BOT_USERNAME=
SHIRIN_TELEGRAM_PROXY_URL=
SHIRIN_WORK_GROUP_ID=0
SHIRIN_WORK_GROUP_TOPIC_ID=0
SHIRIN_GROUP_LANGUAGE=ru
SHIRIN_MINI_APP_URL=https://market.wekulcha.ru/shirin/
SHIRIN_ADMIN_APP_URL=https://adminmarket.wekulcha.online/shirin/
SHIRIN_SUPERADMIN_APP_URL=https://adminmarket.wekulcha.online/shirin/superadmin/
SHIRIN_TIMEZONE=Asia/Tashkent
SHIRIN_UPLOADS_DIR=/app/uploads
SHIRIN_OBJECT_STORAGE_ENDPOINT=https://storage.yandexcloud.net
SHIRIN_OBJECT_STORAGE_REGION=ru-central1
SHIRIN_OBJECT_STORAGE_BUCKET=
SHIRIN_OBJECT_STORAGE_ACCESS_KEY_ID=
SHIRIN_OBJECT_STORAGE_SECRET_ACCESS_KEY=
SHIRIN_OBJECT_STORAGE_PUBLIC_BASE_URL=
SHIRIN_CORS_ALLOWED_ORIGINS=https://market.wekulcha.ru,https://adminmarket.wekulcha.online
SHIRIN_MAX_UPLOAD_BYTES=8388608
SHIRIN_MAX_IMPORT_ROWS=3000
SHIRIN_GATEWAY_NETWORK=shirin_gateway
SHIRIN_SHARED_GATEWAY=true
# Optional: connect an existing gateway container to SHIRIN_GATEWAY_NETWORK.
SHIRIN_SHARED_GATEWAY_CONTAINER=
# Per-container Docker log rotation.
SHIRIN_LOG_MAX_SIZE=10m
SHIRIN_LOG_MAX_FILES=3
