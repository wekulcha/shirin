# Complete replacement for the kulcha-gateway Caddyfile supplied on 2026-10-05.
# Host path on that VM: /opt/kulcha/app/deploy/Caddyfile.
# Preserve any additional server routes if the active file changes later.
# The gateway also needs the kulcha-market_default and shirin_gateway networks.
{
	email {$ACME_EMAIL}
}

{$API_DOMAIN} {
	encode zstd gzip
	reverse_proxy kulcha-backend:8000
}

{$USER_DOMAIN} {
	encode zstd gzip
	reverse_proxy kulcha-user-panel:80
}

{$ADMIN_DOMAIN} {
	encode zstd gzip
	reverse_proxy kulcha-admin-panel:80
}

{$SUPERADMIN_DOMAIN} {
	encode zstd gzip
	reverse_proxy kulcha-superadmin-panel:80
}

market.wekulcha.ru {
	encode zstd gzip
	request_body /shirin/* {
		max_size 9MB
	}
	handle /shirin/api/* {
		reverse_proxy shirin-backend:8000
	}
	handle /shirin/api {
		reverse_proxy shirin-backend:8000
	}
	handle /shirin/webhooks/* {
		reverse_proxy shirin-backend:8000
	}
	handle /shirin {
		redir * /shirin/ 308
	}
	handle /shirin/* {
		reverse_proxy shirin-user-panel:80
	}
	handle {
		reverse_proxy kulcha-market-user-panel:80
	}
}

apimarket.wekulcha.ru {
	encode zstd gzip
	reverse_proxy kulcha-market-backend:8000
}

adminmarket.wekulcha.online {
	encode zstd gzip
	request_body /shirin/* {
		max_size 9MB
	}
	handle /shirin/api/* {
		reverse_proxy shirin-backend:8000
	}
	handle /shirin/api {
		reverse_proxy shirin-backend:8000
	}
	handle /shirin/superadmin {
		redir * /shirin/superadmin/ 308
	}
	handle /shirin/superadmin/* {
		reverse_proxy shirin-superadmin-panel:80
	}
	handle /shirin {
		redir * /shirin/ 308
	}
	handle /shirin/* {
		reverse_proxy shirin-admin-panel:80
	}
	handle {
		reverse_proxy kulcha-market-admin-panel:80
	}
}

supmarket.wekulcha.online {
	encode zstd gzip
	reverse_proxy kulcha-market-superadmin-panel:80
}
