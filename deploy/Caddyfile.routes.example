# Merge these handles into the existing domain blocks, BEFORE their root proxy.
# Keep the /shirin prefix; backend routes already contain it.
# The final 404 is only for a standalone gateway; keep the existing root handler
# when adding Shirin routes to a gateway that already serves other applications.
market.wekulcha.ru {
	encode zstd gzip
	request_body {
		max_size 9MB
	}
	handle /shirin/api/* {
		reverse_proxy shirin-backend:8000
	}
	handle /shirin/api {
		reverse_proxy shirin-backend:8000
	}
	handle /shirin/webhooks/* {
		reverse_proxy shirin-backend:8000
	}
	handle /shirin {
		redir * /shirin/ 308
	}
	handle /shirin/* {
		reverse_proxy shirin-user-panel:80
	}
	handle {
		respond "Not Found" 404
	}
}
adminmarket.wekulcha.online {
	encode zstd gzip
	request_body {
		max_size 9MB
	}
	handle /shirin/api/* {
		reverse_proxy shirin-backend:8000
	}
	handle /shirin/api {
		reverse_proxy shirin-backend:8000
	}
	handle /shirin/superadmin {
		redir * /shirin/superadmin/ 308
	}
	handle /shirin/superadmin/* {
		reverse_proxy shirin-superadmin-panel:80
	}
	handle /shirin {
		redir * /shirin/ 308
	}
	handle /shirin/* {
		reverse_proxy shirin-admin-panel:80
	}
	handle {
		respond "Not Found" 404
	}
}
