# Replace the TWO corresponding Market site blocks in the shared Caddyfile.
# Keep every other site, global setting and custom route in that file.
# These fallback upstreams match the existing kulcha-market containers.
# Keep the /shirin prefix; backend and panel routes already contain it.
# Connect the public gateway (kulcha-gateway on the current VM) to shirin_gateway.
# Use full container names for Kulcha upstreams too: service aliases such as
# backend or user_panel can identify containers from multiple attached networks.
# A dedicated Shirin VM uses Caddyfile.cloud instead of this shared example.
market.wekulcha.ru {
	encode zstd gzip
	request_body {
		max_size 9MB
	}
	handle /shirin/api/* {
		reverse_proxy shirin-backend:8000
	}
	handle /shirin/api {
		reverse_proxy shirin-backend:8000
	}
	handle /shirin/webhooks/* {
		reverse_proxy shirin-backend:8000
	}
	handle /shirin {
		redir * /shirin/ 308
	}
	handle /shirin/* {
		reverse_proxy shirin-user-panel:80
	}
	handle {
		reverse_proxy kulcha-market-user-panel:80
	}
}
adminmarket.wekulcha.online {
	encode zstd gzip
	request_body {
		max_size 9MB
	}
	handle /shirin/api/* {
		reverse_proxy shirin-backend:8000
	}
	handle /shirin/api {
		reverse_proxy shirin-backend:8000
	}
	handle /shirin/superadmin {
		redir * /shirin/superadmin/ 308
	}
	handle /shirin/superadmin/* {
		reverse_proxy shirin-superadmin-panel:80
	}
	handle /shirin {
		redir * /shirin/ 308
	}
	handle /shirin/* {
		reverse_proxy shirin-admin-panel:80
	}
	handle {
		reverse_proxy kulcha-market-admin-panel:80
	}
}
